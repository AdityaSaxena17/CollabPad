NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_your_webhook_signing_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/documents
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/documents

POSTGRES_DB=collab_docs
POSTGRES_USER=collab_docs
POSTGRES_PASSWORD=collab_docs_dev
COLLAB_DOCS_POSTGRES_PORT=55432
DATABASE_URL=postgresql://collab_docs:collab_docs_dev@localhost:55432/collab_docs

GATEWAY_PORT=18080
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_GATEWAY_HTTP_URL=http://localhost:18080
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:18080
LLM_TARGET=llm:50052
LLM_MODEL_DIR=./models
LLM_MODEL_FILE=model.gguf
LLM_N_CTX=4096
LLM_N_THREADS=4
LLM_N_GPU_LAYERS=0

# Optional live Clerk browser tests; use two existing users in your Clerk dev instance.
E2E_OWNER_EMAIL=
E2E_GUEST_EMAIL=
